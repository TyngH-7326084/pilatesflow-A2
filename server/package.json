{
  "name": "pilatesflow-server",
  "version": "0.1.0",
  "description": "PilatesFlow API - Express + MongoDB",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:f4 && npm run test:f1 && npm run test:f2 && npm run test:nfr-f2",
    "test:f4": "node --test test/f4-reschedule.test.js test/f4-concurrency.integration.test.js",
    "test:f1": "node --test test/f1-conflict-detection.test.js test/f1-performance.test.js",
    "test:f2": "node --test test/f2-promotion-strategy.test.js test/f2-promotion.test.js",
    "test:nfr-f2": "node --test test/f2-member-search-performance.test.js"

  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.4"
  }
}
